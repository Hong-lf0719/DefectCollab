# 复制本文件为 .env 并填入实际值（.env 已被 .gitignore 排除，不会提交）
# JWT 签名密钥：生产环境务必改为随机长字符串（可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成）
DEFECT_JWT_SECRET=change-me-to-a-random-string
# Token 有效期（天）
DEFECT_JWT_EXPIRE=30
# 服务监听端口（Docker / 云平台如 Render 会注入此变量；本地默认 8080）
PORT=8080
# 可选：指定数据库文件路径（容器内默认 /app/data/defects.db）
# DEFECT_DB=./defects.db
